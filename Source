\begin{lstlisting}[language=VHDL, caption={Code for 8-bit ALU with 2 registers and opcode}, label=lst:NCO]
library IEEE;
use IEEE.STD_LOGIC_1164.ALL;
use IEEE.STD_LOGIC_UNSIGNED.ALL;
use IEEE.STD_LOGIC_ARITH.ALL;

entity Project3 is
    Port 
    (
        KEY   : in  STD_LOGIC;
        CLK   : in  STD_LOGIC;
        HEX0  : out STD_LOGIC_VECTOR(6 downto 0);
        HEX1  : out STD_LOGIC_VECTOR(6 downto 0);
        HEX2  : out STD_LOGIC_VECTOR(6 downto 0);
        HEX3  : out STD_LOGIC_VECTOR(6 downto 0);
        SW    : in  STD_LOGIC_VECTOR(9 downto 0);
        LEDR  : out STD_LOGIC_VECTOR(9 downto 0)
    );
end Project3;

architecture Behavior of Project3 is

    -- FSM State Definition
    type FSM_States is (Idle, Load_A, Load_B, Operate);
    signal State : FSM_States := Idle;

    -- Internal Registers
    signal A, B, ALU_Result : STD_LOGIC_VECTOR(7 downto 0) := (others => '0');
    signal Opcode    : STD_LOGIC_VECTOR(3 downto 0);
    signal Flags     : STD_LOGIC_VECTOR(7 downto 0) := (others => '0');
    signal Prev_Key  : STD_LOGIC := '0';

    signal Sign_Char : STD_LOGIC_VECTOR(6 downto 0);
    signal Display : STD_LOGIC_VECTOR(8 downto 0) := (others => '0');

    signal Hex_Digits : STD_LOGIC_VECTOR(11 downto 0); -- Holds 3 digits in 4-bit chunks

    -- Helper Functions
    function IsEvenParity(data : STD_LOGIC_VECTOR(7 downto 0)) return STD_LOGIC is
        variable bit_count : INTEGER := 0;
    begin
        for i in data'range loop
            if data(i) = '1' then
                bit_count := bit_count + 1;
            end if;
        end loop;
        return '1' when (bit_count mod 2 = 0) else '0';
    end function;

    function GetSignDisp(neg : BOOLEAN) return STD_LOGIC_VECTOR is
    begin
        if neg then
            return "0111111"; -- '-'
        else
            return "1000000"; -- '0'
        end if;
    end function;

    function Get7Seg(input : STD_LOGIC_VECTOR(3 downto 0)) return STD_LOGIC_VECTOR is
    begin
        case input is
            when "0000" => return "1000000";
            when "0001" => return "1111001";
            when "0010" => return "0100100";
            when "0011" => return "0110000";
            when "0100" => return "0011001";
            when "0101" => return "0010010";
            when "0110" => return "0000010";
            when "0111" => return "1111000";
            when "1000" => return "0000000";
            when "1001" => return "0010000";
            when others => return "1111111";
        end case;
    end function;

begin

    MainLogic : process(CLK)
        variable signed_value : INTEGER;
        variable abs_value    : INTEGER;
        variable extended     : STD_LOGIC_VECTOR(8 downto 0);
    begin
        if rising_edge(CLK) then
            if KEY = '1' and Prev_Key = '0' then
                case State is
                    when Idle =>
                        A <= SW(7 downto 0);
                        State <= Load_B;

                    when Load_B =>
                        B <= SW(7 downto 0);
                        State <= Operate;

                    when Operate =>
                        Opcode <= SW(3 downto 0);
                        Flags  <= (others => '0');
                        extended := (others => '0');

                        case SW(3 downto 0) is
                            when "0000" =>
                                extended := ('0' & A) + ('0' & B); -- ADD
                            when "0001" =>
                                extended := ('0' & A) - ('0' & B); -- SUB
                            when "0010" =>
                                extended := ('0' & (A + 1)); -- INC
                            when "0011" =>
                                extended := ('0' & (A - 1)); -- DEC
                            when "0100" =>
                                extended := "0" & A(6 downto 0) & '0'; -- SHL
                            when "0101" =>
                                extended := "0" & ('0' & A(7 downto 1)); -- SHR
                            when "0110" =>
                                extended := '0' & A; -- PASS A
                            when "1000" =>
                                extended := '0' & (A and B); -- AND
                            when "1001" =>
                                extended := '0' & (A or B); -- OR
                            when "1010" =>
                                extended := '0' & (A xor B); -- XOR
                            when "1011" =>
                                extended := '0' & (not A); -- NOT
                            when "1100" =>
                                extended := "0" & A(6 downto 0) & '0'; -- LOGICAL SHL
                            when "1101" =>
                                extended := "0" & (A(7) & A(7 downto 1)); -- ARITH SHR
                            when "1110" => -- COMPARE
                                if A > B then
                                    Flags(4) <= '1';
                                elsif A = B then
                                    Flags(3) <= '1';
                                else
                                    Flags(2) <= '1';
                                end if;
                            when others =>
                                extended := (others => '0');
                        end case;

                        if SW(3 downto 0) /= "1110" then
                            ALU_Result <= extended(7 downto 0);
                            Flags(7)   <= extended(8); -- Carry
                            Flags(6)   <= IsEvenParity(extended(7 downto 0)); -- Parity

                            -- Overflow Detection
                            if Opcode = "0000" and (A(7) = B(7)) and (extended(7) /= A(7)) then
                                Flags(5) <= '1';
                            elsif Opcode = "0001" and (A(7) /= B(7)) and (extended(7) /= A(7)) then
                                Flags(5) <= '1';
                            end if;

                            if extended(7 downto 0) = "00000000" then
                                Flags(3) <= '1';
                            elsif extended(7) = '1' then
                                Flags(2) <= '1';
                            else
                                Flags(4) <= '1';
                            end if;
                        end if;

                        Display <= extended;
                        State <= Idle;
                end case;
            end if;

            Prev_Key <= KEY;

            -- Sign and Decimal Extraction
            signed_value := CONV_INTEGER(SIGNED(Display(7 downto 0)));
            if signed_value < 0 then
                abs_value := -signed_value;
                Sign_Char <= GetSignDisp(true);
            else
                abs_value := signed_value;
                Sign_Char <= GetSignDisp(false);
            end if;

            Hex_Digits(3 downto 0)   <= CONV_STD_LOGIC_VECTOR(abs_value mod 10, 4);
            Hex_Digits(7 downto 4)   <= CONV_STD_LOGIC_VECTOR((abs_value / 10) mod 10, 4);
            Hex_Digits(11 downto 8)  <= CONV_STD_LOGIC_VECTOR((abs_value / 100) mod 10, 4);
        end if;
    end process;

    -- Output Connections
    HEX0 <= Get7Seg(Hex_Digits(3 downto 0));
    HEX1 <= Get7Seg(Hex_Digits(7 downto 4));
    HEX2 <= Get7Seg(Hex_Digits(11 downto 8));
    HEX3 <= Sign_Char;
    LEDR <= ALU_Result;

end Behavior;

\end{lstlisting}
